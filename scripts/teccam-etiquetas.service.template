[Unit]
Description=Teccam SGT - Servicio de Generación e Impresión de Etiquetas
After=network.target

[Service]
Type=simple
User={{SERVICE_USER}}
Group={{SERVICE_GROUP}}
WorkingDirectory={{PROJECT_DIR}}
Environment="PATH={{PROJECT_DIR}}/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin"
Environment="PORT={{PORT}}"
Environment="HOST={{HOST}}"
Environment="WORKERS={{WORKERS}}"
ExecStart={{PROJECT_DIR}}/venv/bin/gunicorn --bind {{HOST}}:{{PORT}} --workers {{WORKERS}} --access-logfile - --error-logfile - wsgi:app
Restart=always
RestartSec=5s
KillMode=mixed
TimeoutStopSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=teccam-etiquetas

[Install]
WantedBy=multi-user.target
